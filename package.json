{
  "name": "spin-wheel-game",
  "private": false,
  "version": "1.5.0",
  "type": "module",
  "author": "Ajay-Maury",
  "license": "MIT",
  "description": "A customizable spin wheel (prize wheel / wheel of fortune) component for React. TypeScript, responsive, with spin sound. Great for giveaways, raffles and random pickers.",
  "main": "./dist/spin-wheel-game.es.js",
  "module": "./dist/spin-wheel-game.es.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/spin-wheel-game.es.js",
      "default": "./dist/spin-wheel-game.es.js"
    },
    "./package.json": "./package.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ajay-Maury/spin-wheel-game.git"
  },
  "keywords": [
    "react",
    "react-component",
    "react-spin-wheel",
    "spin-wheel",
    "spin-wheel-game",
    "spinning-wheel",
    "spinning-prize-wheel",
    "prize-wheel",
    "wheel-of-prize",
    "wheel-of-fortune",
    "fortune-wheel",
    "lucky-wheel",
    "lucky-draw",
    "roulette",
    "raffle",
    "giveaway",
    "random-picker",
    "decision-wheel",
    "gamification",
    "canvas",
    "typescript"
  ],
  "bugs": {
    "url": "https://github.com/Ajay-Maury/spin-wheel-game/issues"
  },
  "homepage": "https://spin-wheel-game-rho.vercel.app/",
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/Ajay-Maury"
  },
  "scripts": {
    "dev": "vite",
    "prepublish": "npm run build",
    "build": "tsc && vite build",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "react": "^18.3.1",
    "@eslint/js": "^10.0.1",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.2.1",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "react-dom": "^18.3.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vite-plugin-dts": "^5.1.2"
  },
  "files": [
    "dist/**/*"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  }
}
